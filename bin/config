#!/usr/bin/env bash
# @describe Read and write key-value settings across layers.
#
# Settings live in the yaml frontmatter of markdown files and fold in order,
# later wins: module defaults, system, global, local, then SKOGAI_* env.
# Each file layer is a default under <dot>/<defaults>/ and an override under
# <dot>/; all writes go to the override.
# @meta require-tools yq
# @env SKOGAI_CONFIG_BASE_DOT_DIR=.skogai    Dot dir holding every layer, found by walking up
# @env SKOGAI_CONFIG_BASE_DEFAULTS_DIR=base  Dir of committed defaults inside the dot dir

# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC2154 # argc_* come from --argc-eval, _* globals from lib
set -euo pipefail

# @cmd Print the resolved value of one key
# @arg key![`_choice_key`]  Key to read
# @flag --show-origin       Prefix the value with the layer it came from
get() {
    _fold
    if [[ ${argc_show_origin:-} ]]; then
        printf '%s\t%s\n' "${_org[$argc_key]}" "$(_joined "$argc_key")"
    else
        printf '%s\n' "${_val[$argc_key]}"
    fi
}

# @cmd Write a key to a scope's override file
# @arg key![`_choice_known_key`]           Key to write
# @arg value![?`_choice_value`]            Value, read as yaml (null removes the key below)
# @option --scope[=local|system|global]    Scope to write to
set_() {
    _root
    _layers
    local f=${_files[$(_override_index "$argc_scope")]}
    mkdir -p "$(dirname "$f")"
    _has_frontmatter "$f" || printf -- '---\n---\n%s' "$(cat "$f" 2>/dev/null)" >"$f"
    K=$argc_key V=$argc_value yq --front-matter=process -i \
        'del(.. | select((path | map(tostring | sub("_"; "-")) | join(".")) == strenv(K)))
         | .[strenv(K)] = (if strenv(V) == "" then "" else strenv(V) | from_yaml end)' "$f"
}

# @cmd Remove a key from a scope's override file
# @arg key![`_choice_override_key`]        Key set in that scope's override
# @option --scope[=local|system|global]    Scope to remove from
unset_() {
    _root
    _layers
    K=$argc_key yq --front-matter=process -i \
        'del(.. | select((path | map(tostring | sub("_"; "-")) | join(".")) == strenv(K)))' \
        "${_files[$(_override_index "$argc_scope")]}"
}

# @cmd Print every resolved key as key=value, sorted by key
# @flag --show-origin  Prefix each line with the layer it came from
list() {
    _fold
    local k item
    for k in $(_sorted_keys); do
        if [[ ${_kind[$k]} == l && -n ${_val[$k]} ]]; then
            while IFS= read -r item; do _list_line "$k" "$item"; done <<<"${_val[$k]}"
        else
            _list_line "$k" "${_val[$k]}"
        fi
    done
}

# @cmd Print the resolved config as shell export lines
env_() {
    _fold
    local k
    for k in $(_sorted_keys); do
        printf 'export %s=%q\n' "$(_envname "$k")" "${_val[$k]}"
    done
}

# @cmd Print each layer file in fold order and whether it exists
files() {
    _root
    _layers
    local f
    for f in "${_files[@]}"; do
        [[ -f $f ]] && printf '%s\tpresent\n' "$f" || printf '%s\tmissing\n' "$f"
    done
}


# value choices; argc needs these in this file
_choice_key() {
    _fold
    local k
    for k in $(_sorted_keys); do _candidate "$k" "$(_joined "$k")"; done
}

# keys any file layer defines, including ones a later layer nulled
_choice_known_key() {
    _fold
    local k
    for k in $(printf '%s\n' "${!_known[@]}" | LC_ALL=C sort); do
        if [[ -v _val[$k] ]]; then
            _candidate "$k" "$(_joined "$k")"
        else
            _candidate "$k" '(null)'
        fi
    done
}

_choice_value() {
    _fold
    local k=${argc_key:-}
    if [[ -v _val[$k] && ${_kind[$k]} == s ]]; then
        case ${_val[$k]} in
        true | false) printf 'true\nfalse\n' ;;
        *) _candidate "${_val[$k]}" current ;;
        esac
    fi
    _candidate null 'remove the value set below this scope'
}

_choice_override_key() {
    _root
    _layers
    local f=${_files[$(_override_index "${argc_scope:-local}")]} t k v
    while IFS=$'\t' read -r t k v; do
        [[ $t == i ]] || printf '%s\n' "$k"
    done < <(_flatten "$f") | LC_ALL=C sort -u
}

# helpers live in lib/config.sh: ../lib in the repo, ../lib/skogai installed
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
for lib in "$here/../lib/skogai/config.sh" "$here/../lib/config.sh"; do
    if [[ -f $lib ]]; then
        # shellcheck source=../lib/config.sh
        source "$lib"
        break
    fi
done
eval "$(argc --argc-eval "$0" "$@")"
