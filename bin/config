#!/usr/bin/env bash
# Settings are prefixed variables in the [env] of a mise env, and fold in
# mise's order, later wins: system, global, the project's base, then its local
# file. A key is core.debug for SKOGAI_CORE_DEBUG. All writes go to a scope's
# file; the base is committed and never written. list hides values mise marks
# with redact = true. Every location below is a setting; its default follows
# mise's own variables.
# @meta require-tools mise,yq
# @env MISE_ENV=skogai                                    The mise env holding the settings
# @env SKOGAI_CONFIG_PREFIX=SKOGAI_                       Prefix of every setting's variable
# @env SKOGAI_CONFIG_SYSTEM_FILE=`_default_system_file`   System scope
# @env SKOGAI_CONFIG_GLOBAL_FILE=`_default_global_file`   Global scope
# @env SKOGAI_CONFIG_BASE_FILE=`_default_base_file`       Project base, found by walking up: mise.$MISE_ENV.toml
# @env SKOGAI_CONFIG_LOCAL_FILE=`_default_local_file`     Local scope

# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC2154 # argc_* come from --argc-eval, _* globals from lib
set -euo pipefail

# @cmd Print the resolved value of one key
# @arg key![`_choice_key`]  Key to read
# @flag --show-origin       Prefix the value with the layer it came from
get() {
    _fold
    if [[ ${argc_show_origin:-} ]]; then
        printf '%s\t%s\n' "${_org[$argc_key]}" "${_val[$argc_key]}"
    else
        printf '%s\n' "${_val[$argc_key]}"
    fi
}

# @cmd Write a key to a scope's file
# @arg key![`_choice_key`]                 Key to write
# @arg value![?`_choice_value`]            Value
# @option --scope[=local|system|global]    Scope to write to
set_() {
    _root
    local f
    f=$(_scope_file "$argc_scope")
    mkdir -p "$(dirname "$f")"
    mise set -q --file "$f" "$(_envname "$argc_key")=$argc_value"
}

# @cmd Remove a key from a scope's file
# @arg key![`_choice_scope_key`]           Key set in that scope's file
# @option --scope[=local|system|global]    Scope to remove from
unset_() {
    _root
    mise unset -q --file "$(_scope_file "$argc_scope")" "$(_envname "$argc_key")"
}

# @cmd skogix
# @arg myscope![`_choice_example`] <CHOICE>
skogix() {
    echo "scope: ${argc_myscope}"
    # echo "SKOGAI_CONFIG_SYSTEM_FILE: $SKOGAI_CONFIG_SYSTEM_FILE"
    # echo "SKOGAI_CONFIG_LOCAL_FILE: $SKOGAI_CONFIG_LOCAL_FILE"
    # echo "SKOGAI_CONFIG_GLOBAL_FILE: $SKOGAI_CONFIG_GLOBAL_FILE"
}

_choice_example() {
    echo "$SKOGAI_CONFIG_SYSTEM_FILE"
    echo "$SKOGAI_CONFIG_LOCAL_FILE"
    echo "$SKOGAI_CONFIG_GLOBAL_FILE"
}


# @cmd Print every resolved key as key=value, sorted by key
# @flag --show-origin  Prefix each line with the layer it came from
list() {
    _fold
    local k v
    for k in $(_sorted_keys); do
        v=${_val[$k]}
        [[ ${_secret[$k]:-} ]] && v='[redacted]'
        if [[ ${argc_show_origin:-} ]]; then
            printf '%s\t%s=%s\n' "${_org[$k]}" "$k" "$v"
        else
            printf '%s=%s\n' "$k" "$v"
        fi
    done
}

# @cmd Print the resolved config as shell export lines
env_() {
    _fold
    local k
    for k in $(_sorted_keys); do
        printf 'export %s=%q\n' "$(_envname "$k")" "${_val[$k]}"
    done
}

# @cmd Print each scope's file in fold order and whether it exists
files() {
    _root
    local f
    for f in "$SKOGAI_CONFIG_SYSTEM_FILE" "$SKOGAI_CONFIG_GLOBAL_FILE" "$SKOGAI_CONFIG_BASE_FILE" "$SKOGAI_CONFIG_LOCAL_FILE"; do
        [[ -f $f ]] && printf '%s\tpresent\n' "$f" || printf '%s\tmissing\n' "$f"
    done
}


_default_system_file() {
  mise config get --file=/home/skogix/.config/mise/config.skogai.toml skogai.config.system.dir
  # echo "$MISE_SYSTEM_CONFIG_DIR"
    # printf '%s/config.%s.toml\n' "${MISE_SYSTEM_CONFIG_DIR:-/etc/mise}" "$MISE_ENV"
}

_default_global_file() {
  mise config get --file=/home/skogix/.config/mise/config.skogai.toml skogai.config.global.dir
    # printf '%s/config.%s.toml\n' "${MISE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mise}" "$MISE_ENV"
}

_default_base_file() {
  echo ".skogai"
    # printf 'mise.%s.toml\n' "$MISE_ENV"
}

_default_local_file() {
  mise config get --file=/home/skogix/.config/mise/config.skogai.toml skogai.config.local.dir
    # printf 'mise.%s.local.toml\n' "$MISE_ENV"
}

# value choices; argc needs these in this file
_choice_key() {
    _fold
    local k
    for k in $(_sorted_keys); do
        if [[ ${_secret[$k]:-} ]]; then
            _candidate "$k" '[redacted]'
        else
            _candidate "$k" "${_val[$k]}"
        fi
    done
}

_choice_value() {
    _fold
    local k=${argc_key:-}
    [[ -v _val[$k] ]] || return 0
    case ${_val[$k]} in
    true | false) printf 'true\nfalse\n' ;;
    *) _candidate "${_val[$k]}" current ;;
    esac
}

_choice_scope_key() {
    _root
    _file_keys "$(_scope_file "${argc_scope:-local}")"
}

# helpers live in lib/config.sh: ../lib in the repo, ../lib/skogai installed
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
for lib in "$here/../lib/skogai/config.sh" "$here/../lib/config.sh"; do
    if [[ -f $lib ]]; then
        # shellcheck source=../lib/config.sh
        source "$lib"
        break
    fi
done
eval "$(argc --argc-eval "$0" "$@")"
